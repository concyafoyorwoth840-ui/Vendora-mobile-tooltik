{
  "name": "vendora-mobile-toolkit",
  "version": "0.4.0",
  "private": true,
  "description": "Vendora Digitals mobile device diagnostics and recovery toolkit",
  "main": "electron.cjs",
  "scripts": {"start": "electron .", "dist:win": "electron-builder --win nsis x64"},
  "devDependencies": {"electron": "^33.0.0", "electron-builder": "^25.1.8"},
  "build": {
    "appId": "com.vendoradigitals.mobiletoolkit",
    "productName": "Vendora Mobile Toolkit",
    "directories": {"output": "release"},
    "files": ["index.html", "electron.cjs", "src/**/*", "package.json"],
    "extraResources": [{"from": "../backend/dist/VendoraBackend.exe", "to": "backend/VendoraBackend.exe"}],
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}], "artifactName": "Vendora-Mobile-Toolkit-Setup-${version}.${ext}"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true}
  }
}
